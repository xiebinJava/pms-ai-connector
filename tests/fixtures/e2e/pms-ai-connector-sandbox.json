{
  "steps": [
    {
      "operation": "project.create",
      "arguments": {
        "name": "PMS AI Connector sandbox {{runId}}",
        "description": "由 PMS AI Connector 隔离写入验收创建",
        "priority": 1
      },
      "capture": {
        "projectId": "data.project.id",
        "projectVersion": "data.project.version"
      }
    },
    {
      "operation": "project.update",
      "arguments": {
        "projectId": "{{projectId}}",
        "name": "PMS AI Connector sandbox updated {{runId}}",
        "description": "由 PMS AI Connector 隔离写入验收更新"
      },
      "capture": {
        "updatedProjectVersion": "data.project.version"
      }
    }
  ],
  "cleanup": [
    {
      "operation": "project.delete",
      "whenCapture": "projectId",
      "arguments": {
        "projectId": "{{projectId}}",
        "reason": "PMS AI Connector 隔离写入验收清理"
      },
      "idempotencyKey": "pms-e2e-cleanup-closed-loop-{{runId}}"
    },
    {
      "operation": "project.delete",
      "whenCapture": "opencliProjectId",
      "arguments": {
        "projectId": "{{opencliProjectId}}",
        "reason": "PMS AI Connector MCP/OpenCLI 一致性验收清理"
      },
      "idempotencyKey": "pms-e2e-cleanup-adapter-{{runId}}"
    }
  ],
  "assertions": [
    {
      "resourceType": "project",
      "keyword": "PMS AI Connector sandbox updated {{runId}}",
      "page": 1,
      "pageSize": 20
    }
  ],
  "idempotency": {
    "operation": "project.create",
    "arguments": {
      "name": "PMS AI Connector idempotency {{runId}}",
      "description": "重复幂等键不得创建第二个项目",
      "priority": 1
    },
    "idempotencyKey": "pms-e2e-idempotency-create-{{runId}}",
    "capture": {
      "projectId": "data.project.id",
      "projectVersion": "data.project.version"
    }
  },
  "concurrency": {
    "setup": [
      {
        "operation": "project.create",
        "arguments": {
          "name": "PMS AI Connector concurrency {{runId}}",
          "description": "并发版本冲突验收专用项目",
          "priority": 1
        },
        "capture": {
          "projectId": "data.project.id",
          "projectVersion": "data.project.version"
        }
      }
    ],
    "steps": [
      {
        "operation": "project.update",
        "idempotencyKey": "pms-e2e-concurrency-update-a-{{runId}}",
        "arguments": {
          "projectId": "{{projectId}}",
          "name": "PMS AI Connector concurrency A {{runId}}"
        }
      },
      {
        "operation": "project.update",
        "idempotencyKey": "pms-e2e-concurrency-update-b-{{runId}}",
        "arguments": {
          "projectId": "{{projectId}}",
          "name": "PMS AI Connector concurrency B {{runId}}"
        }
      }
    ],
    "expectedKind": "conflict"
  },
  "adapterConsistency": {
    "mcp": {
      "operation": "project.create",
      "arguments": {
        "name": "PMS AI Connector adapter {{runId}}",
        "description": "MCP 与 OpenCLI 结果一致性验收",
        "priority": 1
      },
      "idempotencyKey": "pms-e2e-adapter-mcp-create-{{runId}}",
      "capture": {
        "projectId": "data.project.id"
      }
    },
    "opencli": {
      "operation": "project.create",
      "arguments": {
        "name": "PMS AI Connector adapter {{runId}}",
        "description": "MCP 与 OpenCLI 结果一致性验收",
        "priority": 1
      },
      "idempotencyKey": "pms-e2e-adapter-opencli-create-{{runId}}",
      "capture": {
        "opencliProjectId": "data.project.id"
      }
    }
  },
  "invalidRelations": [
    {
      "operation": "topic.project.link",
      "arguments": {
        "topicId": 2147483000,
        "projectId": 2147483001
      },
      "expectedKind": "not_found"
    },
    {
      "operation": "story.topic.link",
      "arguments": {
        "storyId": 2147483000,
        "topicId": 2147483001
      },
      "expectedKind": "not_found"
    },
    {
      "operation": "project.create",
      "arguments": {
        "name": "PMS AI Connector invalid contract {{runId}}"
      },
      "contract": {
        "id": "stale-contract",
        "version": "v0"
      },
      "expectedKind": "conflict"
    }
  ]
}
