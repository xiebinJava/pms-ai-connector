# PMS integration facade, including the Spring application context path.
PMS_BASE_URL=http://host.docker.internal:8080/api

# Comma-separated exact browser/client origins. Keep this explicit; do not use *.
PMS_MCP_ALLOWED_ORIGINS=https://your-mcp-client.example

PMS_MCP_PORT_HOST=3000
PMS_MCP_REQUIRE_AUTHORIZATION=true
PMS_MCP_ALLOW_INSECURE_LOCALHOST=false
# Set true only when a controlled reverse proxy overwrites X-Forwarded-Proto.
PMS_MCP_TRUST_FORWARDED_PROTO=false
PMS_MCP_LEGACY=reject
PMS_MCP_RESOURCE_PATH=/mcp

# Optional OAuth 2.0 Protected Resource Metadata for remote MCP clients.
# The connector forwards the caller's Bearer token to PMS unchanged; the
# configured issuer/PMS integration must validate or exchange that token.
# PMS_MCP_OAUTH_ISSUER=https://id.example.com/
# PMS_MCP_OAUTH_RESOURCE=https://mcp.example.com/mcp
# PMS_MCP_OAUTH_SCOPES=ai:context:read,ai:query:read,ai:command:preview

# Optional fallback token for trusted internal callers that do not forward
# Authorization. Request Bearer tokens are preferred and are never persisted.
# PMS_AUTH_TOKEN=
